# Swarm env contract. Copy to swarm/.env and fill secrets. NEVER commit swarm/.env.
# Base image / versions
BASE_IMAGE=ghcr.io/heretek-ai/oh-mine-pi:latest
PI_VERSION=latest

# --- OpenCode Go (pooled rotation, decision #4). One key per agent slot. ---
OPENCODE_GO_API_KEY=
OPENCODE_GO_API_KEY_2=
OPENCODE_GO_API_KEY_3=

# --- ZeroTier research trio (EXTERNAL services, decision: integrate only) ---
SEARXNG_BASE_URL=http://10.0.0.10:8888
FIRECRAWL_BASE_URL=http://10.0.0.10:3002
FIRECRAWL_API_VERSION=v1
CRAWL4AI_BASE_URL=http://10.0.0.10:11235
CRAWL4AI_API_TOKEN=
SEARCH_PROVIDERS=searxng,crawl4ai,firecrawl

# --- Extension sets (space-separated `pi install` specs; best-effort, warn-and-continue) ---
COORDINATOR_EXTENSIONS=npm:pi-subagents npm:pi-goal-x npm:pi-fabric npm:pi-sessions npm:pi-multi-account npm:pi-router npm:pi-bifrost npm:@billjr99/pi-openai-compat
RESEARCHER_EXTENSIONS=npm:pi-deep-research npm:@parallel-web/pi-extension
QA_EXTENSIONS=npm:pi-sessions

# --- RE sidecars ---
REA_IMAGE=ghcr.io/alexmi256/rea-agent:latest
MOBSF_IMAGE=opensecurity/mobile-security-framework-mobsf:latest

# --- QA (optional) ---
SEMGREP_APP_TOKEN=
GITHUB_TOKEN=

# --- Phone steering (happier self-host relay joined to ZeroTier; external) ---
HAPPIER_RELAY_URL=
